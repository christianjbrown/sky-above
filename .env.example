# Copy to .env on the Pi and fill it in. .env is gitignored, so the home
# location and feeder keys never reach the repo.

# Shown in the map's title bar.
FEEDER_NAME=Sky Above
# Your time zone, as a name like Europe/London, America/New_York or Australia/Sydney.
# Card times and quiet hours go by it.
FEEDER_TZ=
# Your country's two-letter code (GB, US, DE...). Places there get no flag on the card.
# Left empty, it goes by the nearest airport, which near a border may be the next country's.
HOME_COUNTRY=

# Where the antenna is: decimal degrees, and height above sea level with a
# unit (15m or 50ft). Planes still show without it, but MLAT, range rings and
# the range outline need it.
FEEDER_LAT=
FEEDER_LONG=
FEEDER_ALT=

# Which feeders to run, comma separated: flightaware, flightradar24.
# Leave empty until you have their IDs below.
COMPOSE_PROFILES=
PIAWARE_FEEDER_ID=
FR24KEY=

# The watcher. It casts a card while a plane is within
# ZONE_RADIUS_KM of FEEDER_LAT/FEEDER_LONG, or further out but flying a line
# that will take it through, and hands the screen back
# LINGER_SECONDS after the last one leaves (so a plane wobbling on the edge of the
# zone doesn't flick the card off and on). Until CAST_APP_ID holds the ID
# from the Google Cast SDK Developer Console, it only logs what it would show.
# CAST_DEVICE_NAME is the screen's name as the Google Home app shows it.
CAST_DEVICE_NAME=
CAST_APP_ID=
ZONE_RADIUS_KM=2
LINGER_SECONDS=30
# Keeps each plane's card up at least this long from when it appears, even if the plane
# only clips the edge of the zone, so its announcement gets to finish. A plane coming
# into the zone still takes over straight away; one only on its way waits until this and
# LINGER_SECONDS are up.
CARD_MIN_SECONDS=60
# Leave the screen alone during these hours (empty for never). Comma separated windows,
# each every day or only on some days: 00:00-08:00, Sat 00:00-10:00, Mon-Fri 09:00-17:00.
# One that runs past midnight belongs to the day it starts on.
QUIET_HOURS=00:00-08:00
# Air ambulance and police aircraft get their own look, picked out by the operator
# code at the front of their callsigns, comma separated. In the UK every air ambulance
# flies as HLE and every police aircraft as UKP; leave them empty if yours don't share one.
AIR_AMBULANCE_CALLSIGNS=
POLICE_CALLSIGNS=
# Rare enough to be worth waking up for: these still get a card and a voice in both
# kinds of quiet hours. helicopters, military, both comma separated, or empty for neither.
QUIET_HOURS_EXCEPT=helicopters,military
# Where a flight is going, from adsbdb.com. Only planes passing near home are
# looked up, so adsbdb sees roughly which patch of sky is yours. Set it empty
# to keep every lookup inside the house; cards then show the flight without
# its route.
ROUTE_API_URL=https://api.adsbdb.com/v0
# Better routes from FlightAware's AeroAPI, used instead of adsbdb when a key is
# set. adsbdb's list is fixed and gets some routes wrong; AeroAPI follows the
# flight as it is flown today. Personal keys come from
# https://www.flightaware.com/aeroapi/portal/ and each lookup is paid for past a
# small free allowance, so the watcher stops asking after AEROAPI_MONTHLY_LIMIT
# lookups in a month.
AEROAPI_KEY=
AEROAPI_MONTHLY_LIMIT=1000
# Flights you're following (followed/flights.txt, see the README) have their own
# allowance of AeroAPI lookups a month, so they never use up the ones for planes overhead.
FOLLOWED_MONTHLY_LIMIT=600
# Aircraft photos for the card, from a planespotters.net style API. Empty
# shows a plane symbol instead. planespotters.net refused this app's
# requests when it was tried, so it starts off.
PHOTO_API_URL=
# Says each new nearest flight out loud on the screen, e.g. "F R 2 0 S W from
# Alicante to London Stansted". The words never leave the Pi: Piper turns them
# into a clip there. Add SPEECH_SERVER= (empty) for a silent card.
PIPER_VOICE=en_GB-southern_english_female-low
# No talking during these hours, apart from helicopters (empty to talk any time). Written
# like QUIET_HOURS.
SPEECH_QUIET_HOURS=00:00-08:00
# Mutes the screen for a moment while the card launches, so Google's cast chime goes
# unheard, and the voice waits for the sound to come back. false lets the chime play.
MUTE_CHIME=true

# The card over https. CERT_DOMAIN is a name whose DNS points at the Pi's home
# address; the certs service gets it a Let's Encrypt certificate by adding a
# short-lived TXT record through Spaceship's API, using a key that only has
# DNS records read and write. Leave CERT_DOMAIN empty for http only.
CERT_DOMAIN=
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=

# Where the watchdog sends an alert when the watcher stops working, as a plain text
# POST: an ntfy topic such as https://ntfy.sh/<a-long-random-name> reaches the ntfy app
# on your phone. Empty only logs them (docker logs watchdog).
ALERT_URL=

# Host ports, if the defaults clash with something else on the Pi.
MAP_PORT=8080
RECEIVER_PORT=8090
HTTPS_PORT=443
# Where the watcher hands the live card to the receiver page for browsers.
LIVE_PORT=8091
# Piper, reachable from the Pi itself only.
SPEECH_PORT=10200
FR24_STATUS_PORT=8754
